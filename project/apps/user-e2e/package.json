{
  "name": "@project/user-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@project/user"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@project/user:build",
          "@project/user:serve"
        ],
        "options": {
          "jestConfig": "apps/user-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
