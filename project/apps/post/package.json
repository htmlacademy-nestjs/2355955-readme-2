{
  "name": "@project/post",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/post"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/post/dist/package.json",
          "{workspaceRoot}/apps/post/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/post/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@project/post:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@project/post:build:development"
          },
          "production": {
            "buildTarget": "@project/post:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "db:lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma validate --schema ./prisma/schema.prisma",
          "cwd": "libs/app/core/post-data"
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate dev --schema ./prisma/schema.prisma --skip-generate --skip-seed",
          "cwd": "libs/app/core/post-data"
        }
      },
      "db:reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate reset --schema ./prisma/schema.prisma --force --skip-generate --skip-seed",
          "cwd": "libs/app/core/post-data"
        }
      },
      "db:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma generate --schema ./prisma/schema.prisma",
          "cwd": "libs/app/core/post-data"
        }
      },
      "db:seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx ts-node --project prisma/tsconfig.json prisma/seed.ts",
          "cwd": "libs/app/core/post-data"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  }
}
