{
  "name": "@project/notification-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "@project/notification"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "@project/notification:build",
          "@project/notification:serve"
        ],
        "options": {
          "jestConfig": "apps/notification-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
